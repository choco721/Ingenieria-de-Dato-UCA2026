# Plantilla de variables de entorno. Copiá este archivo a ".env" y ajustá
# si hiciera falta. El .env real NO se sube al repo (está en .gitignore).
#
#     cp .env.example .env      (Linux/Mac/Git Bash)
#     copy .env.example .env    (Windows CMD)
#
# Por ahora el compose trae estos valores hardcodeados, así que no es
# obligatorio usar .env todavía. Queda como base para la Unidad VII,
# donde se estudia por qué las credenciales NO van en el código.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

POSTGRES_USER=datos
POSTGRES_PASSWORD=datos
POSTGRES_DB=serving

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
